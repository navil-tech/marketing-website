{
  "plugins": ["stylelint-plugin-logical-css"],
  "ignoreFiles": [".next/**", "node_modules/**"],
  "rules": {
    "logical-css/require-logical-keywords": [true, { "severity": "error" }],
    "logical-css/require-logical-properties": [
      true,
      {
        "severity": "error",
        "ignore": [
          "top",
          "bottom",
          "margin-top",
          "margin-bottom",
          "padding-top",
          "padding-bottom",
          "border-top",
          "border-bottom",
          "border-top-width",
          "border-bottom-width",
          "border-top-color",
          "border-bottom-color",
          "border-top-style",
          "border-bottom-style",
          "width",
          "height",
          "min-width",
          "max-width",
          "min-height",
          "max-height",
          "overflow-x",
          "overflow-y"
        ]
      }
    ]
  }
}

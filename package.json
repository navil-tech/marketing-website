{
  "name": "marketing-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:control": "TELEGRAM_API_URL=http://127.0.0.1:3101 TELEGRAM_BOT_TOKEN=control TELEGRAM_CHAT_ID=control next start",
    "lint": "eslint && stylelint \"**/*.css\"",
    "lint:fix": "eslint --fix && stylelint \"**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"**/*.css\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "control:run": "tsx control/run.ts",
    "control:verify": "tsx control/verify.ts",
    "control": "tsx control/run.ts && tsx control/verify.ts",
    "control:field": "tsx control/field.ts",
    "control:plan": "tsx control/show-plan.ts",
    "control:selfcheck": "tsx control/selfcheck.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "isbot": "5.2.3",
    "lucide-react": "^1.57.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "stylelint": "^17.16.0",
    "stylelint-plugin-logical-css": "^2.1.0",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
